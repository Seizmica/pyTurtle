# Production.
APP_ENV=prod
APP_VERSION=0.1.0

RAW_ROOT=s3a://raw-prod
CURATED_ROOT=s3a://curated-prod
# Destination for csv hand-off copies, separate from curated parquet.
EXPORT_ROOT=s3a://export-prod

SPARK_MASTER=yarn
SPARK_CONF.spark.sql.adaptive.enabled=true
SPARK_CONF.spark.sql.shuffle.partitions=200
SPARK_CONF.spark.sql.sources.partitionOverwriteMode=dynamic

CHECKPOINT_FORMAT=%Y%m%d%H%M%S

# Where an unhandled failure's traceback is written, so a cluster-mode run can
# be diagnosed without reaching container logs. Empty disables it. The key must
# be declared here even when empty: config.load only lets the process
# environment override keys the file already declares.
FAILURE_REPORT_DIR=hdfs:///tmp/etl-failures

# JVM options for the driver and the executors.
#
# Executor options work from here. Executors are launched after the session
# exists, so a key set in this file reaches them:
# SPARK_CONF.spark.executor.extraJavaOptions=-XX:+UseG1GC
#
# Driver options do NOT work from here, and build_spark warns if you try. The
# driver JVM is already running by the time this file is read -- the
# ApplicationMaster's JVM under --deploy-mode cluster, the local one otherwise
# -- so the key is accepted into the conf and then ignored. Pass them at
# submission instead, which is the same setting --driver-java-options writes to:
#     DRIVER_JAVA_OPTIONS="-Dhttp.proxyHost=proxy" ./submit.sh <job> <env> <date>
# For a local run without spark-submit, use PYSPARK_SUBMIT_ARGS:
#     PYSPARK_SUBMIT_ARGS='--driver-java-options "-Dhttp.proxyHost=proxy" pyspark-shell'

# Hive metastore. The metastore URI itself normally comes from the
# cluster's hive-site.xml; set it here only when it does not.
HIVE_DB=analytics_prod
# SPARK_CONF.hive.metastore.uris=thrift://metastore:9083
