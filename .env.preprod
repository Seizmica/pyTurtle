# Pre-production. Mirrors prod sizing so performance problems surface here.
APP_ENV=preprod
APP_VERSION=0.1.0

RAW_ROOT=s3a://raw-preprod
CURATED_ROOT=s3a://curated-preprod

SPARK_MASTER=yarn
SPARK_CONF.spark.sql.adaptive.enabled=true
SPARK_CONF.spark.sql.shuffle.partitions=200
SPARK_CONF.spark.sql.sources.partitionOverwriteMode=dynamic

CHECKPOINT_FORMAT=%Y%m%d%H%M%S
